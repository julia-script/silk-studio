//! The embedded tweet asset and source formatting.
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.u8
import task_support { pathText, rootPath, repositoryRoot }
import task_native { say }

const TWEET_SOURCE: string = "assets/tweet-challenge.png"

const TWEET_TARGET: string = "modules/editor/src/tweet_asset.silk"

/// The tweet screenshot embedded unchanged, for native rendering and portable SVG export.
pub effect fn embedTweet(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let source = run rootPath(TWEET_SOURCE)
  let png = run FileSystem.readFile(&source)
  let data = Bytes.asSlice(&png)
  let digits = b"0123456789abcdef"
  let mut out = run Bytes.makeWithCapacity(data.length * 6 + 256)
  run Bytes.append(
    &mut out,
    b"//! Generated by silk task embed-tweet from assets/tweet-challenge.png.\npub fn png() -> &'static [u8] {\n  return b\"",
  )
  let mut at: usize = 0
  while at < data.length {
    run Bytes.append(&mut out, b"\\x")
    run Bytes.append(
      &mut out,
      &[digits[u8.toUsize(data[at] / 16)], digits[u8.toUsize(data[at] % 16)]],
    )
    at = at + 1
  }
  run Bytes.append(
    &mut out,
    b"\"\n}\n\npub fn uri() -> string<'static> {\n  return \"data:image/png;base64,",
  )
  let length = match Base64.encodedLength(data.length) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { .. } => run Task.abort(
      "Tweet asset is too large to encode",
    )
  }
  let mut encoded = run Bytes.zeroed(length)
  match Base64.encodeInto(encoded.asMutSlice(), data) {
    Result<usize, Base64Error>.Success { .. } => {}
    Result<usize, Base64Error>.Failure { .. } => run Task.abort("Cannot encode the tweet asset")
  }
  run Bytes.append(&mut out, Bytes.asSlice(&encoded))
  run Bytes.append(&mut out, b"\"\n}\n")
  let target = run rootPath(TWEET_TARGET)
  if check {
    let committed = run FileSystem.readFile(&target)
    if !same(Bytes.asSlice(&committed), Bytes.asSlice(&out)) {
      run Task.abort("Stale modules/editor/src/tweet_asset.silk; run silk task embed-tweet")
    }
    run say("Embedded tweet asset is current")
  } else {
    run FileSystem.writeFile(&target, Bytes.asSlice(&out))
    run say(TWEET_TARGET)
  }
}

/// The browser package must import the WebGPU exports of the exact pinned lib-native.
pub effect fn browserExports(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let native = run repositoryRoot("lib-native")
  let source = run Path.join(&native, "modules/gpu/webgpu/browser/generated_webgpu_exports.silk")
  let bytes = run FileSystem.readFile(&source)
  let target = run rootPath("modules/browser/src/generated_webgpu_exports.silk")
  if check {
    let existing = run FileSystem.readFile(&target)
    if !same(Bytes.asSlice(&bytes), Bytes.asSlice(&existing)) {
      run Task.abort("Stale browser exports; run silk task generate-browser-exports")
    }
    run say("Browser WebGPU exports are current")
  } else {
    run FileSystem.writeFile(&target, Bytes.asSlice(&bytes))
  }
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut at: usize = 0
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + 1
  }
  return true
}

// Generated and embedded files keep generator output byte-for-byte.
fn handMaintained(name: string) -> bool {
  if name == "silk.toml" {
    return true
  }
  return String.endsWith(name, ".silk") && !String.startsWith(name, "generated_")
    && name != "pixels.silk"
    && name != "tweet_asset.silk"
}

effect fn collect(directory: &Path, files: &mut List<String>) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let entries = run FileSystem.listDirectory(directory)
  let items = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < items.length {
    let name = Path.name(&items[at].path) |> Option<string>.unwrapOr("")
    if items[at].kind.code == 1 {
      if !String.startsWith(name, ".") && name != "build" {
        run collect(&items[at].path, &mut files)
      }
    } else if handMaintained(name) {
      run files.append(run String.copy(pathText(&items[at].path)))
    }
    at = at + 1
  }
}

/// Formats hand-maintained sources, or with `check` fails when any would change.
pub effect fn format(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut files = List<String>.make()
  run files.append(run String.copy("silk.toml"))
  let modules = run rootPath("modules")
  run collect(&modules, &mut files)
  let tasks = run rootPath("src")
  run collect(&tasks, &mut files)
  let mut words = List<string>.make()
  run words.append("format")
  if check {
    run words.append("--check")
  }
  let items = files.asSlice()
  let mut at: usize = 0
  while at < items.length {
    run words.append(String.view(&items[at]))
    at = at + 1
  }
  run Task.silk(words.asSlice())
}
